# Claude Code Configuration Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env file with real credentials!

# ============================================
# GitHub Configuration
# ============================================
# Create a Personal Access Token at: https://github.com/settings/tokens
# Required scopes: repo, read:org, read:user
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_token_here

# ============================================
# GitLab Configuration
# ============================================
# Create a Personal Access Token at: https://gitlab.com/-/user_settings/personal_access_tokens
# Required scopes: api, read_api
GITLAB_TOKEN=glpat-your_token_here

# GitLab instance hostname (default: gitlab.com)
# For self-hosted GitLab, use your instance URL
GITLAB_HOST=gitlab.com

# GitLab API version (default: v4)
GITLAB_API_VERSION=v4

# ============================================
# MCP Server Paths
# ============================================
# Path to GitLab MCP server installation
# Default: ~/.config/mcp-servers/gitlab-code-review
# GITLAB_MCP_PATH=~/.config/mcp-servers/gitlab-code-review

# ============================================
# Logging Configuration
# ============================================
# Log level for MCP servers: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================
# Optional: Additional API Tokens
# ============================================
# Add other service tokens as needed for your workflow
# JIRA_API_TOKEN=
# SLACK_API_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
