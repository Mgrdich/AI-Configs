# Claude Code Configuration Environment Variables
# Copy this file to .env and fill in your values
# DO NOT commit .env file with real credentials!

# ============================================
# Target Directories
# ============================================
# Paths to Claude data directories where configs should be installed.
# Each target receives a copy of commands/, agents/, and .mcp.json from this repo.
# Add one CONFIG_SOURCE_DIR line per target directory.
#
CONFIG_SOURCE_DIR=~/.claude-work
CONFIG_SOURCE_DIR=~/.claude-personal
